PROJECT_NAME="KarmaSiksha Backend API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database
DATABASE_URL=postgresql://karmasiksha:karmasiksha_pass@localhost:5432/karmasiksha
ASYNC_DATABASE_URL=postgresql+asyncpg://karmasiksha:karmasiksha_pass@localhost:5432/karmasiksha

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Groq AI
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Other AI Providers (Optional)
AI_PROVIDER=groq
GEMINI_API_KEY=
OPENAI_API_KEY=

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# iGOT
IGOT_INTEGRATION_MODE=demo_adapter
IGOT_API_BASE_URL=https://api.igot.gov.in/api
IGOT_API_KEY=
